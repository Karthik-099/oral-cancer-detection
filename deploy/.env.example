# ── Fill these in on the server (deploy/.env). Never commit the real file. ──

# Public HTTPS name for the API. No domain? Use your VM's public IP with sslip.io:
#   API_DOMAIN=api.203.0.113.10.sslip.io
API_DOMAIN=
# Email for Let's Encrypt certificate notices
ACME_EMAIL=

# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ORALAID_SECRET_KEY=
POSTGRES_PASSWORD=

# The website that calls this API
ORALAID_CORS_ORIGINS=https://oral-cancer-detect.netlify.app

# Optional first admin account
ORALAID_ADMIN_EMAIL=
ORALAID_ADMIN_PASSWORD=

# Model weights: copy final_efficientnet_b4_oral_cancer.pth into ./models on the VM,
# or set an HTTPS download URL (+ checksum) here.
ORALAID_CLASSIFIER_URL=
ORALAID_CLASSIFIER_SHA256=6177f31b15f4d83b118485ee8683b5cb3914f5d26bb061a62b81fa2da96ff3a0
HF_TOKEN=

# CPU threads for inference (Oracle Ampere A1 with 4 OCPUs: 4)
ORALAID_TORCH_THREADS=4
